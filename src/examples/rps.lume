var{
  player: input=1
  pc: 0
  result: 0
  names: ["石头", "剪刀", "布"]
}

msg{ "石头剪刀布：1=石头 2=剪刀 3=布，0 退出" }

loop{
  input{
    id:1
    min:0
    max:3
    "你的出拳"
    over: "只能输入 0-3"
    under: "只能输入 0-3"
    invalid: "请输入数字"
  }

  if{ player == 0 { break } }

  set{ pc: rand(1, 3) }
  set{ result: (player - pc + 3) % 3 }

  msg{ "你出 " + names[player - 1] + "，电脑出 " + names[pc - 1] }

  if{
    result == 0{ msg{ "平局" } }
    else if result == 1{ msg{ "你赢了" } }
    else{ msg{ "你输了" } }
  }
}

msg{ "再见" }