-- ============================================================
-- 暗影森林 · 三结局剧情游戏
-- Lume v0.3 可跑版
-- ============================================================

var{
  import: "file"

  hp: 100
  courage: 0
  wisdom: 0
  kindness: 0

  node: 1
  choice: input=1
  running: 1
  i: 0
}

-- ============================================================
-- 工具
-- ============================================================

func printStatus(){
  msg{ "------------------------------" }
  msg{ "HP: " + hp + "  勇气: " + courage + "  智慧: " + wisdom + "  善良: " + kindness }
  msg{ "------------------------------" }
}

func saveGame(){
  var{
    text: ""
  }
  set{ text: "hp:" + hp + "|courage:" + courage + "|wisdom:" + wisdom + "|kindness:" + kindness + "|node:" + node }
  file_write{
    path: "examples/story_save.txt"
    content: text
  }
  msg{ "[已存档]" }
}

func showChoices(a, b, c, d){
  msg{ "1. " + a }
  if{ b != "" { msg{ "2. " + b } } }
  if{ c != "" { msg{ "3. " + c } } }
  if{ d != "" { msg{ "4. " + d } } }
}

func askChoice(){
  input{
    id:1
    min:1
    max:4
    "你的选择"
  }
}

-- ============================================================
-- 开场
-- ============================================================

msg{ "===============================" }
msg{ "      暗影森林 · 三结局" }
msg{ "===============================" }
msg{ "" }
msg{ "你在深夜醒来，发现自己躺在森林边缘。" }
msg{ "远处有三条隐约的小路，雾气弥漫。" }
msg{ "" }
printStatus()

-- ============================================================
-- 节点 1：森林入口
-- ============================================================

func node1(){
  msg{ "" }
  msg{ "【森林入口】" }
  msg{ "左边的小路传来流水声，中间的隐有光点，右边的幽深黑暗。" }
  msg{ "" }
  showChoices("走左边的小路", "走中间的光点", "走右边的黑暗", "在路边休息")
  askChoice()

  if{
    choice == 1{
      msg{ "你沿着水声前进……" }
      set{ wisdom: wisdom + 2 }
      set{ node: 2 }
    }
    else if choice == 2{
      msg{ "你朝光点走去，心中涌起勇气。" }
      set{ courage: courage + 2 }
      set{ node: 3 }
    }
    else if choice == 3{
      msg{ "你深吸一口气，踏入黑暗。" }
      set{ courage: courage + 1 }
      set{ hp: hp - 10 }
      set{ node: 4 }
    }
    else{
      msg{ "你靠着树休息了一会儿。" }
      set{ hp: hp + 20 }
      set{ node: 1 }
    }
  }
}

-- ============================================================
-- 节点 2：溪流边
-- ============================================================

func node2(){
  msg{ "" }
  msg{ "【溪流边】" }
  msg{ "溪水清澈，一位白发老人正坐在石头上钓鱼。" }
  msg{ "他看着你，缓缓开口：'年轻人，你为何而来？'" }
  msg{ "" }
  showChoices("诚实地回答", "反问他", "默默离开", "")
  askChoice()

  if{
    choice == 1{
      msg{ "你说出了寻找归途的目的。老人点头：'诚实者，值得帮助。'" }
      set{ wisdom: wisdom + 3 }
      set{ kindness: kindness + 1 }
      msg{ "老人递给你一张地图。" }
      set{ node: 5 }
    }
    else if choice == 2{
      msg{ "老人笑了：'敢问问题的人，往往能找到答案。'" }
      set{ wisdom: wisdom + 2 }
      set{ node: 5 }
    }
    else{
      msg{ "你默默离开，老人叹了口气。" }
      set{ node: 1 }
    }
  }
}

-- ============================================================
-- 节点 3：林间空地
-- ============================================================

func node3(){
  msg{ "" }
  msg{ "【林间空地】" }
  msg{ "空地上立着一座石像，石像前插着一把锈剑。" }
  msg{ "石像的眼睛似乎动了一下。" }
  msg{ "" }
  showChoices("拔起锈剑", "绕开石像", "触摸石像", "")
  askChoice()

  if{
    choice == 1{
      msg{ "锈剑意外地轻。一道光芒闪过，剑身变得锋利。" }
      set{ courage: courage + 3 }
      set{ node: 6 }
    }
    else if choice == 2{
      msg{ "你小心绕过石像，什么也没发生。" }
      set{ node: 1 }
    }
    else{
      msg{ "石像突然开口：'勇敢者，你的选择将决定命运。'" }
      set{ courage: courage + 1 }
      set{ wisdom: wisdom + 1 }
      set{ node: 6 }
    }
  }
}

-- ============================================================
-- 节点 4：黑暗深处
-- ============================================================

func node4(){
  msg{ "" }
  msg{ "【黑暗深处】" }
  msg{ "黑暗中传来低吼。一只受伤的狼挡在路中间。" }
  msg{ "它的腿上有伤，眼神里既有敌意又有恐惧。" }
  msg{ "" }
  showChoices("帮助它", "绕开它", "拔出武器", "")
  askChoice()

  if{
    choice == 1{
      msg{ "你撕下衣角为它包扎。狼低声呜咽，然后让开了路。" }
      set{ kindness: kindness + 3 }
      set{ node: 5 }
    }
    else if choice == 2{
      msg{ "你小心翼翼绕开，狼没有追你。" }
      set{ node: 1 }
    }
    else{
      msg{ "狼受惊扑来，你受了伤。" }
      set{ hp: hp - 30 }
      set{ node: 1 }
    }
  }
}

-- ============================================================
-- 节点 5：古树
-- ============================================================

func node5(){
  msg{ "" }
  msg{ "【古树】" }
  msg{ "一棵巨大的古树拦在路中，树干上刻着奇怪的符文。" }
  msg{ "树下坐着一个哭泣的孩子。" }
  msg{ "" }
  showChoices("先安慰孩子", "研究符文", "两者都要做", "")
  askChoice()

  if{
    choice == 1{
      msg{ "孩子止住哭，告诉你符文的意思。" }
      set{ kindness: kindness + 2 }
      set{ wisdom: wisdom + 2 }
      set{ node: 7 }
    }
    else if choice == 2{
      msg{ "你花了一小时才读懂符文：'真诚者得通路。'" }
      set{ wisdom: wisdom + 3 }
      set{ node: 7 }
    }
    else{
      msg{ "你一边安慰孩子，一边研究符文。时间久了些，但都成功了。" }
      set{ kindness: kindness + 2 }
      set{ wisdom: wisdom + 2 }
      set{ hp: hp - 5 }
      set{ node: 7 }
    }
  }
}

-- ============================================================
-- 节点 6：祭坛
-- ============================================================

func node6(){
  msg{ "" }
  msg{ "【祭坛】" }
  msg{ "一座石祭坛立在眼前，坛上放着一颗发光的宝石。" }
  msg{ "石碑写着：'取走宝石者，需承担代价。'" }
  msg{ "" }
  showChoices("拿走宝石", "留下宝石", "用剑劈开祭坛", "")
  askChoice()

  if{
    choice == 1{
      msg{ "宝石在你手中融化，你感到力量涌来。" }
      set{ courage: courage + 3 }
      set{ hp: hp - 20 }
      set{ node: 8 }
    }
    else if choice == 2{
      msg{ "你尊重石碑，绕道而行。" }
      set{ kindness: kindness + 1 }
      set{ node: 8 }
    }
    else{
      msg{ "剑光闪过，祭坛裂开，里面是通往出口的密道。" }
      set{ courage: courage + 2 }
      set{ node: 8 }
    }
  }
}

-- ============================================================
-- 节点 7：林间小径
-- ============================================================

func node7(){
  msg{ "" }
  msg{ "【林间小径】" }
  msg{ "前方出现两条路：一条通向山巅的光，一条通向谷底的村。" }
  msg{ "" }
  showChoices("走向山巅", "走向村庄", "原地坐下", "")
  askChoice()

  if{
    choice == 1{
      set{ node: 10 }
    }
    else if choice == 2{
      set{ node: 9 }
    }
    else{
      msg{ "你坐下来，回想一路的风景。" }
      set{ node: 10 }
    }
  }
}

-- ============================================================
-- 节点 8：石桥
-- ============================================================

func node8(){
  msg{ "" }
  msg{ "【石桥】" }
  msg{ "一座古老的石桥横跨深渊，对面是自由。" }
  msg{ "桥头站着一位蒙面人：'想过去，留下你最珍贵的东西。'" }
  msg{ "" }
  showChoices("留下勇气", "留下智慧", "留下善良", "转身离开")
  askChoice()

  if{
    choice == 1{
      set{ courage: 0 }
      set{ node: 11 }
    }
    else if choice == 2{
      set{ wisdom: 0 }
      set{ node: 11 }
    }
    else if choice == 3{
      set{ kindness: 0 }
      set{ node: 11 }
    }
    else{
      msg{ "你转身，不再回头。" }
      set{ node: 1 }
    }
  }
}

-- ============================================================
-- 节点 9：村庄（结局）
-- ============================================================

func node9(){
  msg{ "" }
  msg{ "【谷底村庄】" }
  msg{ "炊烟袅袅，村民看见你，纷纷围上来。" }
  msg{ "" }

  if{
    kindness >= 5{
      msg{ "因为你一路的善良，村民们热情款待你。" }
      msg{ "你在这里住下，成为村子的一员。" }
      msg{ "" }
      msg{ "========== 结局 · 归乡 ==========" }
      msg{ "你找到了新的家。" }
    }
    else{
      msg{ "村民们对你并不热情，你只得到一碗水。" }
      msg{ "你继续流浪。" }
      msg{ "" }
      msg{ "========== 结局 · 流浪者 ==========" }
      msg{ "你离开了村庄。" }
    }
  }
  msg{ "评分：善良 " + kindness + " / 智慧 " + wisdom + " / 勇气 " + courage }
  set{ running: 0 }
}

-- ============================================================
-- 节点 10：山巅（结局）
-- ============================================================

func node10(){
  msg{ "" }
  msg{ "【山巅】" }
  msg{ "山顶上，一位老者正仰望星空。" }
  msg{ "他转身看你：'你走了很远。你想要什么？'" }
  msg{ "" }

  if{
    wisdom >= 6{
      msg{ "你说出你的感悟，老者微笑点头。" }
      msg{ "他指向天空：'你已明白，答案就在你心中。'" }
      msg{ "" }
      msg{ "========== 结局 · 智者 ==========" }
      msg{ "你成为一位传说中的人物。" }
    }
    else if courage >= 5{
      msg{ "你大声宣告，老者大笑。" }
      msg{ "他递给你一把钥匙：'勇者，去开创你的时代。'" }
      msg{ "" }
      msg{ "========== 结局 · 英雄 ==========" }
      msg{ "你成为一位传说中的人物。" }
    }
    else{
      msg{ "你沉默不语，老者摇头。" }
      msg{ "你被一阵风送下山。" }
      msg{ "" }
      msg{ "========== 结局 · 归途 ==========" }
      msg{ "你回到了起点。" }
    }
  }
  msg{ "评分：善良 " + kindness + " / 智慧 " + wisdom + " / 勇气 " + courage }
  set{ running: 0 }
}

-- ============================================================
-- 节点 11：桥对岸（结局）
-- ============================================================

func node11(){
  msg{ "" }
  msg{ "【桥对岸】" }
  msg{ "你过了桥，晨光照在脸上。" }
  msg{ "但失去的东西，再也回不来了。" }
  msg{ "" }
  msg{ "========== 结局 · 代价 ==========" }
  msg{ "你得到了自由，也失去了自己的一部分。" }
  msg{ "评分：善良 " + kindness + " / 智慧 " + wisdom + " / 勇气 " + courage }
  set{ running: 0 }
}

-- ============================================================
-- 主循环
-- ============================================================

while{
  running == 1{
    if{
      node == 1{ node1() }
      else if node == 2{ node2() }
      else if node == 3{ node3() }
      else if node == 4{ node4() }
      else if node == 5{ node5() }
      else if node == 6{ node6() }
      else if node == 7{ node7() }
      else if node == 8{ node8() }
      else if node == 9{ node9() }
      else if node == 10{ node10() }
      else if node == 11{ node11() }
      else{
        msg{ "未知节点，退出" }
        set{ running: 0 }
      }
    }
  }
}

msg{ "" }
msg{ "感谢游玩！" }